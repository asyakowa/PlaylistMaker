<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:orientation="vertical"
    android:layout_height="match_parent"
    android:background="@color/playlistInfoBackgtoundColor"
    >

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:orientation="vertical"
        android:layout_height="match_parent">



        <androidx.appcompat.widget.Toolbar
            android:id="@+id/backButtonPlayer"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:visibility="visible"
            android:elevation="10dp"
            app:layout_constraintStart_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:navigationIconTint="#1A1B22"
            app:navigationIcon="@drawable/backbtn" />

        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/leftBorder"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            app:layout_constraintGuide_begin="16dp" />


        <ImageView
            android:id="@+id/placeholderNewPlaylist"
            android:layout_width="0dp"
            android:layout_height="360dp"

            app:layout_constraintBottom_toTopOf="@id/playlistName"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            tools:src="@drawable/placeholder" />

        <TextView
            android:fontFamily="@font/ys_display_bold"
            android:id="@+id/playlistName"
             android:layout_width="0dp"
            android:textColor="@color/playlistName"
            android:textFontWeight="700"
            android:textSize="24sp"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="@id/leftBorder"
            app:layout_constraintTop_toBottomOf="@id/placeholderNewPlaylist"
            tools:text="Best songs 2021" />

        <TextView
            android:id="@+id/descriptionOfPlaylist"
             android:layout_width="0dp"
            android:textColor="@color/playlistName"
            android:textFontWeight="400"
            android:textSize="18sp"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            app:layout_goneMarginTop="0dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/leftBorder"
            app:layout_constraintTop_toBottomOf="@id/playlistName"
            tools:text="2022" />

        <TextView
            android:id="@+id/timeDuration"
             android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textColor="@color/playlistName"
            android:textFontWeight="400"
            android:textSize="18sp"
            app:layout_constraintEnd_toStartOf="@id/dot"
            app:layout_constraintStart_toEndOf="@id/leftBorder"
            app:layout_constraintTop_toBottomOf="@id/descriptionOfPlaylist"
            tools:text="300 минут" />

        <ImageView
            android:id="@+id/dot"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/dot2"
            app:layout_constraintBottom_toBottomOf="@id/timeDuration"
            app:layout_constraintStart_toEndOf="@id/timeDuration"
            app:layout_constraintTop_toTopOf="@id/timeDuration" />

        <TextView
            android:textColor="@color/playlistName"
            android:textFontWeight="400"
            android:textSize="18sp"
            android:id="@+id/trackCount"
             android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintStart_toEndOf="@id/dot"
            app:layout_constraintTop_toTopOf="@id/timeDuration"
            tools:text="98 треков" />


        <ImageView
            android:id="@+id/ShareButton"
             android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginTop="14dp"
            android:src="@drawable/share"
            android:visibility="visible"

            app:tint="@color/sharenMenuBtnsColor"
            app:layout_constraintStart_toStartOf="@id/leftBorder"
            app:layout_constraintTop_toBottomOf="@id/timeDuration" />

        <ImageView
            android:id="@+id/menuButton"
             android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/more_b"
            app:tint="@color/sharenMenuBtnsColor"
            android:layout_marginStart="14dp"
             app:layout_constraintBottom_toBottomOf="@+id/ShareButton"
            app:layout_constraintStart_toEndOf="@id/ShareButton"
            app:layout_constraintTop_toTopOf="@id/ShareButton" />

    </androidx.constraintlayout.widget.ConstraintLayout>



    <LinearLayout
        android:id="@+id/playlists_info_bottom_sheet"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bottom_sheet_bg"
        android:orientation="vertical"
        app:behavior_hideable="false"
        app:behavior_peekHeight="228dp"
        app:layout_behavior="com.google.android.material.bottomsheet.BottomSheetBehavior">
        <View
            android:id="@+id/overlay"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#801A1B22"
            android:visibility="gone" />
        <View
            android:layout_width="50dp"
            android:layout_height="4dp"
            android:layout_gravity="center"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="12dp"
            android:background="@drawable/rounder" />

        <TextView
            android:id="@+id/tv_empty"
            android:textSize="19sp"
            android:fontFamily="@font/ys_display_medium"
            android:textFontWeight = "500"
            android:textColor="@color/noTracks"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:padding="16dp"
            android:text="@string/no_tracks"
            android:visibility="gone" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/playlistsRecyclerView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/playlists_bottom_sheet"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bottom_sheet_bg"
        android:orientation="vertical"
        app:behavior_hideable="true"
        app:behavior_peekHeight="333dp"
        app:layout_behavior="com.google.android.material.bottomsheet.BottomSheetBehavior">

        <View
            android:layout_width="50dp"
            android:layout_height="4dp"
            android:layout_gravity="center"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="12dp"
            android:background="@drawable/rounder_bsh2" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:orientation="horizontal"
            android:paddingLeft="12dp">

            <ImageView
                android:id="@+id/playlist_cover"
                android:layout_width="48dp"

                android:layout_height="48dp"
                android:layout_gravity="center_vertical"
                android:layout_marginRight="6dp"
                android:background="@drawable/rounded_cover"
                android:clipToOutline="true"
                android:scaleType="centerCrop"

                />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:orientation="vertical">

                <TextView
                    android:textSize="16sp"
                    android:textColor="@color/shareEditdelete"
                    android:fontFamily="@font/ys_display_regular"
                    android:id="@+id/playlist_name_bsh"
                     android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    tools:text="Best songs 2021" />

                <TextView
                    android:textColor="@color/colorCountTracks"
                    android:textSize="11sp"
                    android:fontFamily="sans-serif"
                    android:textFontWeight="400"
                     android:id="@+id/playlist_tracks_count"
                     android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    tools:text="98 треков" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/shareButton"
             android:layout_width="match_parent"
            android:layout_height="60dp"
            android:text="@string/shareplaylist"
            android:gravity="center_vertical"
            android:textFontWeight="400"
            android:textColor="@color/shareEditdelete"
            android:paddingStart="16dp"
            android:fontFamily="@font/ys_display_regular"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/editInfoButton"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:textFontWeight="400"
            android:text="@string/edit_info"
            android:gravity="center_vertical"
            android:fontFamily="@font/ys_display_regular"

            android:textColor="@color/shareEditdelete"
            android:paddingStart="16dp"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/deletePlaylistButton"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:textColor="@color/shareEditdelete"
            android:paddingStart="16dp"
            android:textSize="16sp"
            android:gravity="center_vertical"
            android:textFontWeight="400"
            android:fontFamily="@font/ys_display_regular"
            android:text="@string/delete_playlist" />

    </LinearLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
